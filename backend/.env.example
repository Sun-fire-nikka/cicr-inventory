# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL (primary + read replica)
NEON_PRIMARY_HOST=your-primary-endpoint.neon.tech
NEON_REPLICA_HOST=your-replica-endpoint.neon.tech
NEON_DATABASE=neondb
NEON_USER=your_neon_user
NEON_PASSWORD=your_neon_password
NEON_BRANCH_ID=your_branch_id
NEON_PROJECT_ID=your_project_id
NEON_API_KEY=your_neon_api_key

# Supabase (legacy — removed after full migration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_READ_URL=

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ISSUER=
JWT_AUDIENCE=

# Redis (optional — falls back to in-memory when unset)
REDIS_URL=

# Express Session
SESSION_SECRET=your_session_secret_here

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="CICR Inventory Support" <your_email@gmail.com>

# Due-date reminder scheduler (src/services/reminderScheduler.ts)
# Requires migrations/002_add_reminder_sent_at_to_borrow_records.sql to be applied.
# Set REMINDERS_ENABLED=false to disable the sweep entirely.
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=3600000
REMINDER_LEAD_HOURS=24
REMINDER_BATCH_LIMIT=100
REMINDER_CRON=0 9 * * *
