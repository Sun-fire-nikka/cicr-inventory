PORT=5000
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
JWT_SECRET=your_jwt_secret_key

# Email (SMTP) - optional; falls back to mock (console log) when SMTP_USER is empty
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CICR Lab Admin" <no-reply@cicr.edu>

# Due-date reminder scheduler (src/services/reminderScheduler.ts)
# Requires migrations/002_add_reminder_sent_at_to_borrow_records.sql to be applied.
# Set REMINDERS_ENABLED=false to disable the sweep entirely.
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=3600000
REMINDER_LEAD_HOURS=24
REMINDER_BATCH_LIMIT=100